<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Love Story ❤️</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Romantic Fonts -->
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        .font-cursive { font-family: 'Dancing Script', cursive; }
        .font-sans { font-family: 'Inter', sans-serif; }
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-pink-50 font-sans text-gray-800 antialiased overflow-x-hidden">

    <!-- 1. Background Music Player (Streaming Herbal Tea Direct Link) -->
    <div class="fixed bottom-5 right-5 z-50 bg-white/80 backdrop-blur-md p-3 rounded-full shadow-lg flex items-center space-x-2 border border-pink-200">
        <audio id="bg-music" loop>
            <source src="https://chosic.com" type="audio/mpeg">
        </audio>
        <button id="music-btn" class="text-2xl focus:outline-none">🎵</button>
        <span class="text-xs font-semibold text-pink-600 hidden md:inline">Herbal Tea ☕</span>
    </div>

    <!-- Hero Showcase Section -->
    <header class="relative min-h-screen flex flex-col items-center justify-center text-center bg-cover bg-center px-4" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('photo1.jpg');">
        <div class="z-10 max-w-xl w-full">
            <span class="text-white uppercase tracking-widest text-sm bg-pink-600/80 px-3 py-1 rounded-full">Now Playing</span>
            <h1 class="font-cursive text-6xl md:text-8xl text-white mt-4 drop-shadow-md">Our Love Movie</h1>
            
            <!-- Side-by-Side Media Grid -->
            <div class="mt-6 flex flex-row items-center justify-center gap-4 max-w-md mx-auto">
                <!-- 2. Your Custom Morning GIF (Uploaded to your GitHub root) -->
                <div class="w-36 h-36 overflow-hidden rounded-2xl shadow-xl border-4 border-white bg-white flex-shrink-0">
                    <img src="morning.gif" alt="Good Morning Asset" class="w-full h-full object-cover">
                </div>
                
                <!-- 3. Molang Love Heart GIF (Direct Link Restored) -->
                <div class="w-36 h-36 overflow-hidden rounded-2xl shadow-xl border-4 border-white bg-white flex-shrink-0">
                    <img src="https://giphy.com" alt="Molang Heart Animation" class="w-full h-full object-cover">
                </div>
            </div>

            <p class="text-pink-100 text-lg md:text-xl mt-6 tracking-wide px-4">A story of us, miles apart but close at heart</p>
            <a href="#gallery" class="mt-8 inline-block bg-white text-pink-600 font-semibold px-6 py-3 rounded-full shadow-md hover:bg-pink-100 transition transform hover:scale-105">Open Scrapbook 👇</a>
        </div>
    </header>

    <!-- Photo Gallery / Scrapbook Chapters -->
    <main id="gallery" class="max-w-5xl mx-auto px-4 py-16 space-y-24">
        <h2 class="text-center font-cursive text-5xl text-pink-600">Chapters of Us</h2>

        <!-- Chapter 1 -->
        <section class="flex flex-col md:flex-row items-center gap-8 bg-white p-6 rounded-2xl shadow-sm border border-pink-100">
            <div class="w-full md:w-1/2 overflow-hidden rounded-xl shadow-inner">
                <img src="photo1.jpg" alt="Where it started" class="w-full h-80 object-cover hover:scale-105 transition duration-500">
            </div>
            <div class="w-full md:w-1/2 space-y-4">
                <span class="text-xs font-bold text-pink-500 tracking-widest uppercase">Chapter I</span>
                <h3 class="text-2xl font-semibold text-gray-900">Where It All Began</h3>
                <p class="text-gray-600 leading-relaxed">From the very first message to the late-night calls that lasted until sunrise.</p>
                <span class="inline-block text-sm font-medium text-pink-600 bg-pink-50 px-3 py-1 rounded-md">📅 October 12, 2024</span>
            </div>
        </section>
    </main>

    <!-- Interactive Button Section -->
    <section class="bg-pink-600 text-white text-center py-16 px-4">
        <h2 class="font-cursive text-5xl mb-4">A Special Note For You</h2>
        <button id="open-letter-btn" class="bg-white text-pink-600 font-bold px-8 py-4 rounded-full shadow-lg hover:bg-pink-50 transition transform hover:scale-105">
            ✉️ Open My Letter
        </button>
    </section>

    <!-- Overlay Popup Card (The Letter) -->
    <div id="letter-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-50 items-center justify-center p-4">
        <div class="bg-amber-50 max-w-lg w-full p-8 rounded-xl shadow-2xl border-4 border-double border-amber-200 relative">
            <button id="close-letter-btn" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-xl font-bold">&times;</button>
            <h3 class="font-cursive text-4xl text-amber-800 border-b border-amber-200 pb-2 mb-4">My Dearest,</h3>
            <div class="text-amber-900 space-y-4 leading-relaxed font-serif text-base min-h-[150px]">
                <!-- Typewriter text inserts here -->
            </div>
            <p class="font-cursive text-3xl text-amber-800 text-right mt-6">Forever Yours, ❤️</p>
        </div>
    </div>

    <!-- JavaScript Logic Bundle -->
    <script>
        // Media Audio Controller
        const music = document.getElementById('bg-music');
        const musicBtn = document.getElementById('music-btn');

        musicBtn.addEventListener('click', () => {
            if (music.paused) {
                music.play().catch(err => console.log("Audio blocked: ", err));
                musicBtn.textContent = '⏸️';
            } else {
                music.pause();
                musicBtn.textContent = '🎵';
            }
        });

        // Letter Modal Popup & Interactive Typewriter
        const modal = document.getElementById('letter-modal');
        const openBtn = document.getElementById('open-letter-btn');
        const closeBtn = document.getElementById('close-letter-btn');
        const letterContainer = document.querySelector('#letter-modal .text-amber-900');
        
        const originalText = `Thank you for being my absolute favorite person, my best friend, and my biggest comfort. No matter how many miles separate us right now, remember that every single day brings us one step closer to never having to say goodbye again. I love you to the moon and back. Always.`;
        
        let typingStarted = false;

        function typeWriterEffect(text, element, speed = 40) {
            element.innerHTML = ''; 
            let i = 0;
            function type() {
                if (i < text.length) {
                    element.innerHTML += text.charAt(i);
                    i++;
                    setTimeout(type, speed);
                }
            }
            type();
        }

        openBtn.addEventListener('click', () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Starts audio play securely upon clicking button
            music.play().catch(() => {});
            musicBtn.textContent = '⏸️';

            if (!typingStarted) {
                typingStarted = true;
                typeWriterEffect(originalText, letterContainer, 45); 
            }
        });

        closeBtn.addEventListener('click', () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        });

        // Floating Hearts Particle Stream System
        function createHeart() {
            const heart = document.createElement('div');
            heart.innerHTML = '❤️';
            heart.classList.add('fixed', 'pointer-events-none', 'z-40');
            
            const startPositionX = Math.random() * window.innerWidth;
            const size = Math.random() * 20 + 12; 
            const duration = Math.random() * 3 + 4; 
            const opacity = Math.random() * 0.4 + 0.6;

            heart.style.left = `${startPositionX}px`;
            heart.style.bottom = `-50px`;
            heart.style.fontSize = `${size}px`;
            heart.style.opacity = opacity;
            heart.style.transition = `transform ${duration}s linear, opacity ${duration}s linear`;

            document.body.appendChild(heart);

            setTimeout(() => {
                const drift = (Math.random() - 0.5) * 160; 
                heart.style.transform = `translate(${drift}px, -${window.innerHeight + 100}px) rotate(${drift}deg)`;
                heart.style.opacity = '0';
            }, 100);

            setTimeout(() => {
                heart.remove();
            }, duration * 1000);
        }

        // Spawns a floating heart element every 450 milliseconds
        setInterval(createHeart, 450);
    </script>
</body>
</html>
